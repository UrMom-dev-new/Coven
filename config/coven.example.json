{
  "server": {
    "host": "127.0.0.1",
    "port": 8765,
    "dataDir": "%LOCALAPPDATA%/CovenAgentWorkspace"
  },
  "runtime": {
    "mode": "live",
    "hermesExecutable": "hermes",
    "hermesApiBaseUrl": "http://127.0.0.1:8642",
    "hermesApiKeyEnvironmentVariable": "HERMES_API_SERVER_KEY",
    "hermesBoard": "coven",
    "allowDemoMode": true
  },
  "providers": {
    "ollama": {
      "baseUrl": "http://127.0.0.1:11434/v1",
      "model": "replace-with-local-model"
    },
    "openai": {
      "apiKeyEnvironmentVariable": "OPENAI_API_KEY",
      "model": "replace-with-configured-api-model"
    }
  },
  "voice": {
    "enabled": true,
    "defaultInput": "push-to-talk",
    "engine": "whisper.cpp",
    "modelProfile": "base.en-q5_1",
    "language": "en",
    "microphoneId": "default",
    "inferenceThreads": 2,
    "maxDurationSeconds": 60,
    "retainAudio": false,
    "runtimeExecutable": "",
    "runtimeDir": "%LOCALAPPDATA%/Coven/voice/runtime",
    "modelDir": "%LOCALAPPDATA%/Coven/voice/models",
    "maxAudioBytes": 12582912,
    "allowApiTranscription": false,
    "allowApiSpeech": false
  },
  "workspace": {
    "allowedRoots": [
      "%USERPROFILE%/Documents/CovenWork"
    ]
  },
  "office": {
    "enabled": false,
    "bridgeExecutable": "",
    "operationTimeoutSeconds": 60
  },
  "microsoftGraph": {
    "enabled": false,
    "cloud": "commercial",
    "tenantId": "",
    "clientId": "",
    "tokenEnvironmentVariable": "COVEN_GRAPH_ACCESS_TOKEN"
  },
  "govdash": {
    "enabled": false,
    "route": "sharepoint",
    "baseUrl": "",
    "sharePointRoot": "",
    "browserProfileDir": "%LOCALAPPDATA%/Coven/GovDashBrowser"
  },
  "cinematics": {
    "failureScene": true,
    "reducedMotionMode": "tableau",
    "muteByDefault": false
  }
}
